# ============================================================================
# The Invisible Woman — environment variables
# Copy to .env.local (never commit it). ALL secrets are SERVER-ONLY.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; they must be non-secret.
# The browser never talks to Gemini, Bhashini or Supabase directly.
# Validate at boot with zod in src/server/env.ts (fail fast in production,
# disable the affected feature with a warning in development).
# ============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development                 # development | test | production
DEFAULT_LANGUAGE=ta                 # must be an enabled LanguageCode
ENABLED_LANGUAGES=                  # optional CSV override of config/languages.ts, e.g. ta,hi
ACTIVE_SCHEME_ID=example-housing-001
SCHEME_SOURCE=file                  # file | supabase | supabase_with_file_fallback
ALLOW_DRAFT_SCHEMES=true            # MUST be false when APP_ENV=production (boot must refuse otherwise)
SCHEME_STALE_AFTER_DAYS=90          # older verification => dataFreshness 'stale' => extra "check official site" disclaimer
SESSION_TTL_HOURS=24
RATE_LIMIT_TURNS_PER_MIN=20         # per session id and per IP (in-memory limiter is enough for the prototype)
LOG_CONTENT=false                   # true only on a local machine with synthetic data; forced false in production

# --- Gemini (server only) -----------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash       # confirm the current model id before the hackathon; keep configurable
GEMINI_TIMEOUT_MS=8000
GEMINI_UNDERSTAND_TEMPERATURE=0
GEMINI_COMPOSE_TEMPERATURE=0.3

# --- Bhashini (server only) ---------------------------------------------------
# Credentials come from your Bhashini/ULCA account. Confirm exact required values
# against the CURRENT Bhashini docs; endpoint details live ONLY in src/server/speech/bhashini.ts.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=               # only if the current pipeline-config API requires it
BHASHINI_ASR_TIMEOUT_MS=10000
BHASHINI_TTS_TIMEOUT_MS=8000
ENABLE_BHASHINI_ASR=true
ENABLE_BHASHINI_TTS=true

# --- Supabase (server only; service-role key bypasses RLS, never expose) ------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_MS=3000

# --- Public (non-secret, safe in browser) -------------------------------------
NEXT_PUBLIC_ENABLE_BROWSER_SPEECH=true   # use browser SpeechRecognition/speechSynthesis as 2nd-tier fallback
NEXT_PUBLIC_MAX_RECORDING_SECONDS=15

# --- Ingestion tool only (tools/ingest; NOT used by the web app) ---------------
INGEST_ALLOWED_HOSTS=               # CSV allow-list of official hosts, e.g. example.gov.in,example.nic.in
INGEST_OUTPUT_DIR=./data/ingest
